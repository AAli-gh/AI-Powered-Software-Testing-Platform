# Copy to `.env` and adjust. `.env` is git-ignored — never commit real secrets.
# Every application setting is prefixed with TESTMIND_.

# ---------------------------------------------------------------- application
# development | test | production
TESTMIND_ENV=development
TESTMIND_LOG_LEVEL=INFO
# true = JSON logs (recommended in containers), false = human-readable console logs
TESTMIND_LOG_JSON=true

# ---------------------------------------------------------------- PostgreSQL
# Used by the postgres container and to build TESTMIND_DATABASE_URL in docker-compose.yml.
POSTGRES_USER=testmind
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=testmind

# Only needed when running the API/worker outside Docker (e.g. `uv run uvicorn ...`).
# Must use the asyncpg driver.
TESTMIND_DATABASE_URL=postgresql+asyncpg://testmind:change-me-local-only@localhost:5432/testmind

# ---------------------------------------------------------------- Redis / Celery
TESTMIND_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- API access
# Bearer token every /api/ request must carry (at least 32 characters; required when
# TESTMIND_ENV=production). Generate one with: openssl rand -hex 32
# Unset: the API is open, so keep the ports on 127.0.0.1.
# TESTMIND_API_TOKEN=
# State-changing requests per client and minute (0 disables the limit).
TESTMIND_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------- published ports
# docker compose publishes both on 127.0.0.1 only.
# TESTMIND_API_PORT=8000
# TESTMIND_WEB_PORT=8080

# ---------------------------------------------------------------- repositories
# Directory that contains the local repositories TestMind is allowed to read.
# Projects can only point to sub-directories of this root (path traversal is rejected).
# Inside Docker this is always /repos; the host directory mounted there is:
TESTMIND_HOST_REPOS_DIR=./examples
# Used when running outside Docker:
TESTMIND_REPOS_ROOT=./examples

# ---------------------------------------------------------------- AI test generation
# Provider: anthropic | disabled. To enable AI features, add your Anthropic key to .env under
# the variable name ANTHROPIC_API_KEY. It is read by the Anthropic SDK itself and never stored
# in TestMind's settings. Without a key, AI endpoints answer 503 llm_not_configured.
TESTMIND_LLM_PROVIDER=anthropic
TESTMIND_LLM_MODEL=claude-opus-5
TESTMIND_GENERATION_MAX_ITERATIONS=3
TESTMIND_GENERATION_MAX_TARGETS=10

# ---------------------------------------------------------------- sandbox (generated tests)
# Built with `make sandbox-image`. The worker needs Docker access to use it; without it,
# generated tests are stored as "unverified" (see docs/security.md).
TESTMIND_SANDBOX_IMAGE=testmind-sandbox:local
TESTMIND_SANDBOX_TIMEOUT_SECONDS=120
TESTMIND_SANDBOX_MEMORY=512m
TESTMIND_SANDBOX_CPUS=1
# For the compose worker to use the sandbox (`make up-sandbox`, docker-compose.sandbox.yml):
# absolute host directories, mounted at the same paths in the worker and the sandbox proxy.
# TESTMIND_SANDBOX_DIR=/srv/testmind/sandbox
# TESTMIND_HOST_REPOS_DIR must then be absolute as well.

# ---------------------------------------------------------------- coverage
# Functions whose coverage is below this percentage are reported as coverage gaps.
TESTMIND_COVERAGE_THRESHOLD=80

# ---------------------------------------------------------------- failure analysis
# Failure groups explained by the LLM per requested analysis (the deterministic analysis
# always covers every failure).
TESTMIND_FAILURE_ANALYSIS_MAX_GROUPS=10

# ---------------------------------------------------------------- mutation testing
# Server cap on mutants per mutation run (riskiest functions first).
TESTMIND_MUTATION_MAX_MUTANTS=200
# Cap on one mutant's test run, and on the whole mutation container.
TESTMIND_MUTATION_MUTANT_TIMEOUT_SECONDS=60
TESTMIND_MUTATION_JOB_TIMEOUT_SECONDS=1800
# Surviving mutants per AI test-suggestion job.
TESTMIND_MUTATION_MAX_SUGGESTIONS=10

# ---------------------------------------------------------------- API and browser testing
# Endpoint gaps per AI API test-suggestion job.
TESTMIND_API_MAX_SUGGESTIONS=10
# Sandbox image with a headless Chromium for Playwright tests (`make browser-image`). Unset:
# projects with browser tests report install_failed with the reason.
# TESTMIND_BROWSER_SANDBOX_IMAGE=testmind-sandbox-browser:local

# ---------------------------------------------------------------- GitHub App (docs/github.md)
# All unset: the GitHub endpoints answer 503 github_not_configured. Never commit real values.
# TESTMIND_GITHUB_APP_ID=123456
# The App's private key (PEM). On one line with \n for the line breaks, or as a file:
# TESTMIND_GITHUB_PRIVATE_KEY=<the PEM file's content on one line, \n for each line break>
# TESTMIND_GITHUB_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# The webhook secret configured on the App (a long random string):
# TESTMIND_GITHUB_WEBHOOK_SECRET=
# Owners whose repositories may be analysed, comma-separated (empty: any installation):
# TESTMIND_GITHUB_ALLOWED_OWNERS=my-org,my-user
# TESTMIND_GITHUB_API_URL=https://api.github.com
# TESTMIND_GITHUB_CHECK_NAME=TestMind
# TESTMIND_GITHUB_MAX_ARCHIVE_MB=200
# Where imported repositories are written (docker compose: the github-imports volume):
# TESTMIND_GITHUB_IMPORTS_ROOT=./.imports
# This API's public URL, for links in pull request comments:
# TESTMIND_PUBLIC_URL=https://testmind.example.com
