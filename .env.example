# Copy to `.env` and adjust. `.env` is git-ignored — never commit real secrets.
# Every application setting is prefixed with TESTMIND_.

# ---------------------------------------------------------------- application
# development | test | production
TESTMIND_ENV=development
TESTMIND_LOG_LEVEL=INFO
# true = JSON logs (recommended in containers), false = human-readable console logs
TESTMIND_LOG_JSON=true

# ---------------------------------------------------------------- PostgreSQL
# Used by the postgres container and to build TESTMIND_DATABASE_URL in docker-compose.yml.
POSTGRES_USER=testmind
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=testmind

# Only needed when running the API/worker outside Docker (e.g. `uv run uvicorn ...`).
# Must use the asyncpg driver.
TESTMIND_DATABASE_URL=postgresql+asyncpg://testmind:change-me-local-only@localhost:5432/testmind

# ---------------------------------------------------------------- Redis / Celery
TESTMIND_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- repositories
# Directory that contains the local repositories TestMind is allowed to read.
# Projects can only point to sub-directories of this root (path traversal is rejected).
# Inside Docker this is always /repos; the host directory mounted there is:
TESTMIND_HOST_REPOS_DIR=./examples
# Used when running outside Docker:
TESTMIND_REPOS_ROOT=./examples
